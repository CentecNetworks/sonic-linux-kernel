+	stats->rx_mtu1B_pkt             +=   readq(&priv->cpumac_mem_v2p0->CpuMacStatsRam19[2]);
+	stats->tx_ucast_bytes           +=   readq(&priv->cpumac_mem_v2p0->CpuMacStatsRam20[0]);
+	stats->tx_ucast_pkt             +=   readq(&priv->cpumac_mem_v2p0->CpuMacStatsRam20[2]);
+	stats->tx_mcast_bytes           +=   readq(&priv->cpumac_mem_v2p0->CpuMacStatsRam21[0]);
+	stats->tx_mcast_pkt             +=   readq(&priv->cpumac_mem_v2p0->CpuMacStatsRam21[2]);
