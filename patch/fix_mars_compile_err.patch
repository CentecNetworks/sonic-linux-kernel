-static int 
-mars_read_status(struct phy_device *phydev)
-{
-    int val = 0;
-    int ret = 0;
-    int lpa = 0, page = 0;
-
-    /* Update the link, but return if there was an error */
-    ret = mars_update_link(phydev);
-    if (ret < 0)
-        return ret;
-    if (g_port_status)
-        page = CTC_SDS_REG_SPACE;
-    else
-        page = CTC_PHY_REG_SPACE;
-
-    phydev->speed = SPEED_10;
-    phydev->duplex = DUPLEX_HALF;
-    phydev->pause = 0;
-    phydev->asym_pause = 0;
-
-    val = mars_page_read(phydev, page, CTC_MARS_SSREG);
-    if (val < 0)
-        return val;
-
-    lpa = mars_page_read(phydev, page, MII_LPA);
-    if (lpa < 0)
-        return lpa;
-
-    if (val & 0x8000) 
-    {
-        phydev->speed = SPEED_1000;
-        phydev->duplex = DUPLEX_FULL;
-    } 
-    else if (val & 0x4000) 
-    {
-        phydev->speed = SPEED_100;
-        if (val & 0x2000)
-            phydev->duplex = DUPLEX_FULL;
-    } 
-    else if (val & 0x2000) 
-    {
-        phydev->duplex = DUPLEX_FULL;
-    }
-
-    if (phydev->duplex == DUPLEX_FULL) 
-    {
-        phydev->pause = lpa & LPA_PAUSE_CAP ? 1 : 0;
-        phydev->asym_pause = lpa & LPA_PAUSE_ASYM ? 1 : 0;
-    }
-
-    return 0;
-}
-
-static int 
-mars_get_port_type(struct phy_device *phydev)
-{
-    int val;
-
-    val = mars_ext_read(phydev, CTC_MARS_CHIP_CFG_REG);
-    if (val < 0)
-        return val;
-    val &= 0x7;
-
-    if (0x0 == val || 0x3 == val) 
-    {
-        g_port_type = MARS_PORT_TYPE_UTP;
-        g_port_status = MARS_PORT_TYPE_UTP;
-    } 
-    else if (0x1 == val || 0x4 == val || 0x5 == val) 
-    {
-        g_port_type = MARS_PORT_TYPE_FIBER;
-        g_port_status = MARS_PORT_TYPE_FIBER;
-    } 
-    else 
-    {
-        g_port_type = MARS_PORT_TYPE_COMBO;
-    }
-
-    return 0;
-}
