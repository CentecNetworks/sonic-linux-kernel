+static int ctcmac_enet_open(struct net_device *dev)
+{
+	struct ctcmac_private *priv = netdev_priv(dev);
+	int err;
+
+	ctcmac_pps_cfg(priv);
+	
+	err = ctcmac_init_phy(dev);
+	if(err){
+		return err;
+	}
+
+	err = ctcmac_request_irq(priv);
+	if (err){
+		return err;
+	}
+
+	err = startup_ctcmac(dev);
+	if (err){
+		return err;
+	}
+
+	return 0;
+}
