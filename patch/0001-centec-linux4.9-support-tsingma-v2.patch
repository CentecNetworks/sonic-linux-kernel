+static irqreturn_t ctcmac_tx_isr(int irq, void *data)
+{
+	struct ctcmac_private *priv = (struct ctcmac_private *)data;
+
+	ctcmac_transmit(irq, priv);
+	
+	return IRQ_HANDLED;
+}
