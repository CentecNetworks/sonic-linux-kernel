From 7c00ed1809cbd4a98df037c36e660dd60fa7c0c2 Mon Sep 17 00:00:00 2001
From: "yiheng.zzm" <yiheng.zzm@alibaba-inc.com>
Date: Fri, 10 Jun 2022 09:36:12 +0000
Subject: [PATCH] entec arm64 add support spi flash gd25q256

---
 drivers/mtd/spi-nor/spi-nor.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/mtd/spi-nor/spi-nor.c b/drivers/mtd/spi-nor/spi-nor.c
index b2b62cea..f1e1e913 100644
--- a/drivers/mtd/spi-nor/spi-nor.c
+++ b/drivers/mtd/spi-nor/spi-nor.c
@@ -202,6 +202,7 @@ static inline int set_4byte(struct spi_nor *nor, const struct flash_info *info,
 		need_wren = true;
 	case SNOR_MFR_MACRONIX:
 	case SNOR_MFR_WINBOND:
+    case SNOR_MFR_GIGADEVICE:
 		if (need_wren)
 			write_enable(nor);
 
@@ -850,6 +851,11 @@ static const struct flash_info spi_nor_ids[] = {
 			SECT_4K | SPI_NOR_DUAL_READ | SPI_NOR_QUAD_READ |
 			SPI_NOR_HAS_LOCK | SPI_NOR_HAS_TB)
 	},
+    {
+		 "gd25q256", INFO(0xc84019, 0, 64 * 1024, 512,
+            SECT_4K | SPI_NOR_DUAL_READ | SPI_NOR_QUAD_READ |
+            SPI_NOR_HAS_LOCK | SPI_NOR_HAS_TB)
+	},
 
 	/* Intel/Numonyx -- xxxs33b */
 	{ "160s33b",  INFO(0x898911, 0, 64 * 1024,  32, 0) },
-- 
2.17.1

