+static void ctcmac_pps_disable(struct ctcmac_private *priv)
+{
+	priv->rx_queue[0]->pps_limit = 0;
+	priv->rx_queue[1]->pps_limit = 0;
+	del_timer(&priv->token_timer);
+}
