+#define CTCMAC_FUNC0_RX_R   (1<<1)
+#define CTCMAC_FUNC1_RX_D   (1<<0)
+#define CTCMAC_FUNC1_RX_R   (1<<1)
+
+#define CTC_DDR_BASE 0x80000000
+
+#define CSA_SGMII_MD_MASK 0x00000008 
+#define CSA_EN  0x00000001
