+    void *vaddr;
+    dma_addr_t dma;
+    u32 len;
+    u32 offset;
+    bool alloc;
+};
+
+struct ctcmac_priv_tx_q {
+	spinlock_t txlock __attribute__ ((aligned (SMP_CACHE_BYTES)));
