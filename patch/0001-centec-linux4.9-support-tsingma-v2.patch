+#ifdef CONFIG_ARCH_TSINGMA
+static __maybe_unused int ctcmac_set_ffe_v2p0(struct ctcmac_private *priv, u16 coefficient[])
+{
+	u32 val0;
+
+	/* PRE-EMP */
+	ctc_mac_hss_read(priv->cpumacu_reg_v2p0, priv->index, 0x5e, &val0);
+	val0 &= ~0xf;
+	val0 |= coefficient[0];
+	ctc_mac_hss_write(priv->cpumacu_reg_v2p0, priv->index, 0x5e, val0);
+
+	/* MAIN-EMP */
+	ctc_mac_hss_read(priv->cpumacu_reg_v2p0, priv->index, 0x5e, &val0);
+	val0 &= ~0x3e00;
+	val0 |= (coefficient[1]<<9);
+	ctc_mac_hss_write(priv->cpumacu_reg_v2p0, priv->index, 0x5e, val0);
+
+	/* POST-EMP */
+	ctc_mac_hss_read(priv->cpumacu_reg_v2p0, priv->index, 0x5e, &val0);
+	val0 &= ~0xf0;
+	val0 |= (coefficient[2]<<4);
+	ctc_mac_hss_write(priv->cpumacu_reg_v2p0, priv->index, 0x5e, val0);
+
+	/* PRE/POST-EMP FORCE */
+	ctc_mac_hss_read(priv->cpumacu_reg_v2p0, priv->index, 0x5e, &val0);
+	val0 |= (1<<8);
+	ctc_mac_hss_write(priv->cpumacu_reg_v2p0, priv->index, 0x5e, val0);
+
+	/* MAIN-EMP  FORCE */
+	ctc_mac_hss_read(priv->cpumacu_reg_v2p0, priv->index, 0x5e, &val0);
+	val0 |= (1<<14);
+	ctc_mac_hss_write(priv->cpumacu_reg_v2p0, priv->index, 0x5e, val0);
+
+	/* TX_EMPH1_EN */
+	ctc_mac_hss_read(priv->cpumacu_reg_v2p0, priv->index, 0xa5, &val0);
+	val0 |= (1<<0);
+	ctc_mac_hss_write(priv->cpumacu_reg_v2p0, priv->index, 0xa5, val0);
+
+	/* TX_EMPH0_EN */
+	ctc_mac_hss_read(priv->cpumacu_reg_v2p0, priv->index, 0xa5, &val0);
+	val0 |= (1<<1);
+	ctc_mac_hss_write(priv->cpumacu_reg_v2p0, priv->index, 0x5a5, val0);
+
+	return 0;
+}
+
+static __maybe_unused int ctcmac_get_ffe_v2p0(struct ctcmac_private *priv, u16 coefficient[])
+{
+	u32 val0;
+
+	ctc_mac_hss_read(priv->cpumacu_reg_v2p0, priv->index, 0x5e, &val0);
+	coefficient[0] = val0&0xf;
+    coefficient[1] = (val0&0x3e00)>>9;
+	coefficient[2] = (val0 & 0xf0)>>4;
+
+	return 0;
+}
