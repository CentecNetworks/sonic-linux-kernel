+static int ctc_mac_hss_write(struct CpuMacUnit_regs_v2p0 *cpumacu_reg_v2p0, u8 accid, u16 addr, u16 data)
+{
+	u32 val0 = 0, val1 = 0;
+
+	accid &= 0x7;
+	val0 = addr | (data<<16);
+	val1 = (accid<<16) | (1<<31);
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1RegAccCtl[0]);
+	writel(val1, &cpumacu_reg_v2p0->CpuMacUnit12G1RegAccCtl[1]);
+	mdelay(1);
+	val1 &= ~(1<<31);
+	writel(val1, &cpumacu_reg_v2p0->CpuMacUnit12G1RegAccResult);
+
+	return 0;
+}
+
+static int ctc_mac_hss_read(struct CpuMacUnit_regs_v2p0 *cpumacu_reg_v2p0, u8 accid, u16 addr, u32 *data)
+{
+	u32 val0 = 0, val1 = 0;
+
+	accid &= 0x7;
+	val0 = addr;
+	val1 = (1<<0)|(accid<<16)|(1<<31);
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1RegAccCtl[0]);
+	writel(val1, &cpumacu_reg_v2p0->CpuMacUnit12G1RegAccCtl[1]);
+	mdelay(1);
+	val1 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1RegAccResult);
+	*data = val1 & 0xffff;
+	val1 &= ~(1<<31);
+	writel(val1, &cpumacu_reg_v2p0->CpuMacUnit12G1RegAccResult);
+
+	return 0;
+}
