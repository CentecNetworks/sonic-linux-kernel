+static void ctcmac_set_multi(struct net_device *dev)
+{
+	int idx = 0;
+	u32 val, addr_h=0, addr_l=0;
+	struct netdev_hw_addr *ha;
+	struct ctcmac_private *priv = netdev_priv(dev);
+
+	if(priv->version == 0)
+		return ;
+	
+	/* receive all packets */
+	if (dev->flags & IFF_PROMISC) {
+		/* not check normal packet */
+		if(priv->index == 0){		
+			val = readl(&priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[1]);
+			val &= ~BIT(CPU_MAC_UNIT_FILTER_CFG1_W1_CFG_CHECK_NORMAL_PKT_ENABLE0_BIT_V2P0);
+			writel(val, &priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[1]);
+		}else{
+			val = readl(&priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[1]);
+			val &= ~BIT(CPU_MAC_UNIT_FILTER_CFG1_W1_CFG_CHECK_NORMAL_PKT_ENABLE1_BIT_V2P0);
+			writel(val, &priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[1]);
+		}
+		return ;
+	}
+
+	if(priv->index == 0){	
+		val = readl(&priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[1]);
+		val |= BIT(CPU_MAC_UNIT_FILTER_CFG1_W1_CFG_CHECK_NORMAL_PKT_ENABLE0_BIT_V2P0);
+		val |= BIT(CPU_MAC_UNIT_FILTER_CFG1_W1_CFG_DROP_NORMAL_PKT0_BIT_V2P0);
+		writel(val, &priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[1]);
+	}else{
+		val = readl(&priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[1]);
+		val |= BIT(CPU_MAC_UNIT_FILTER_CFG1_W1_CFG_CHECK_NORMAL_PKT_ENABLE1_BIT_V2P0);
+		val |= BIT(CPU_MAC_UNIT_FILTER_CFG1_W1_CFG_DROP_NORMAL_PKT1_BIT_V2P0);
+		writel(val, &priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[1]);
+	}
+		
+	/* receive packets with local mac address
+	    receive packets with broadcast mac address
+	    receive packets with multicast mac address 
+	*/
+	if((dev->flags & IFF_ALLMULTI) || (netdev_mc_count(dev) > 2)){
+		/* mac filter table 2/6:white list to receive all pacekt with multicast mac address  */
+		if(priv->index == 0){
+			writel(0x00000000, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[4]);
+			writel(0x00000100, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[5]);
+			writel(0x00000000, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[20]);
+			writel(0x00000100, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[21]);
+		}else{
+			writel(0x00000000, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[12]);
+			writel(0x00000100, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[13]);
+			writel(0x00000000, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[28]);
+			writel(0x00000100, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[29]);
+		}
+		return ;
+	}
+	
+	if (netdev_mc_empty(dev)){
+		return;
+	}
+	/* receive packet with local mac address */
+	/* receive packet with broadcast mac address */
+	/* receive packet with multicast mac address in mc list */
+	netdev_for_each_mc_addr(ha, dev) {
+		addr_h = ha->addr[0]<<8 | ha->addr[1]; 
+		addr_l = ha->addr[2]<<24 | ha->addr[3]<<16 | ha->addr[4]<<8 | ha->addr[5];
+		if(priv->index == 0){
+			writel(addr_l, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[4+idx*2]);
+			writel(addr_h, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[5+idx*2]);
+			writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[20+idx*2]);
+			writel(0x0000ffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[21+idx*2]);
+		}else{
+			writel(addr_l, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[12+idx*2]);
+			writel(addr_h, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[13+idx*2]);
+			writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[28+idx*2]);
+			writel(0x0000ffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[29+idx*2]);
+		}
+		idx++;
+		if(idx>=2)
+			return;
+	}
+}
