+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0xe9, &val0);
+	val0 |= 0x40;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0xe9, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x5e, &val0);
+	val0 &= ~0x4000;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x5e, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x111, &val0);
+	val0 &= ~0x4;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x111, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0xdb, &val0);
+	val0 &= ~0xf0;
+	val0 |= (0x8<<4);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0xdb, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0xdb, &val0);
+	val0 &= ~0xf;
+	val0 |= (0x5<<0);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0xdb, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0xe7, &val0);
+	val0 &= ~0xc0;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0xe7, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x136, &val0);
+	val0 &= ~0xf800;
+	val0 |= (0x10<<11);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x136, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x144, &val0);
+	val0 &= ~0x7;
+	val0 |= (0x7<<0);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x144, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x13f, &val0);
+	val0 &= ~0xe000;
+	val0 |= (0x7<<13);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x13f, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x131, &val0);
+	val0 &= ~0xfc00;
+	val0 |= (0x18<<10);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x131, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x131, &val0);
+	val0 &= ~0x3f0;
+	val0 |= (0x18<<4);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x131, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x90, &val0);
+	val0 |= 0x8;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x90, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x21, &val0);
+	val0 &= ~0x3000;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x21, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x84, &val0);
+	val0 |= 0x800;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x84, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x134, &val0);
+	val0 &= ~0xfc00;
+	val0 |= (0x3e<<10);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x134, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x6, &val0);
+	val0 &= ~0xf00;
+	val0 |= (1<<8);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x6, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x23, &val0);
+	val0 |= 0x100;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x23, val0);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1HssReset);	
+	val0 &= ~CPU_MAC_UNIT_12G1_HSS_RESET_W0_CFG_HSS_L1_RST_FSM_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1HssReset);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0xe, &val0);
+	val0 &= ~0x300;
+	val0 |= (2<<8);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0xe, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0xe, &val0);
+	val0 &= ~0xc0;
+	val0 |= (1<<6);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0xe, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0xe, &val0);
+	val0 &= ~0x38;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0xe, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0xe, &val0);
+	val0 &= ~0x7;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0xe, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x110, &val0);
+	val0 &= ~0x70;
+	val0 |= (2<<4);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x110, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x110, &val0);
+	val0 &= ~0xf;
+	val0 |= (0x5<<0);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x110, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x111, &val0);
+	val0 &= ~0x1;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x111, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0xe, &val0);
+	val0 |= 0x2000;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0xe, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x110, &val0);
+	val0 &= ~0xc000;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x110, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x110, &val0);
+	val0 &= ~0x3000;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x110, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0xd, &val0);
+	val0 |= 0x8000;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0xd, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0xd, &val0);
+	val0 &= ~0x7000;
+	val0 |= (4<<12);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0xd, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0xd, &val0);
+	val0 &= ~0x3e;
+	val0 |= (0x16<<1);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0xd, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0xd, &val0);
+	val0 &= ~0x780;
+	val0 |= (1<<7);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0xd, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 1, 0x3d, &val0);
+	val0 &= ~0xf;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 1, 0x3d, val0);
+
+	mdelay(100);
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1HssStatsMon[1]);
+	if((val0&0x30) != 0x30){
+		printk("CpuMacUnit12G1HssStatsMon[0] 0x%x\n", val0);
+	}
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1RxCfg[1]);
+	val0 |= CPU_MAC_UNIT_12G1_RX_CFG_W0_HSS_RX_CFG_0_CFG_RX_INIT_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1RxCfg[1]);
+
+	mdelay(100);
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1HssStatsMon[1]);
+	if((val0&0x1) != 0x1){
+		printk("CpuMacUnit12G1HssStatsMon[0] 0x%x\n", val0);
+	}
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1RxCfg[1]);
+	val0 &= ~CPU_MAC_UNIT_12G1_RX_CFG_W0_HSS_RX_CFG_0_CFG_RX_INIT_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1RxCfg[1]);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1HssReset);	
+	val0 &= ~CPU_MAC_UNIT_12G1_HSS_RESET_W0_RESET_HSS_GRP_ACC_MASK_V2P0;
+	//val0 &= ~CPU_MAC_UNIT_12G1_HSS_RESET_W0_RESET_L1_GEARBOX_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1HssReset);
+
+	return 0;
+}
