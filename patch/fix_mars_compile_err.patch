 int mars_config_init(struct phy_device *phydev)
 {
-	int val;
-	u32 features;
-
-    mars_set_link_timer_2_6ms(phydev);
-
-	features = (SUPPORTED_TP | SUPPORTED_MII
-			| SUPPORTED_AUI | SUPPORTED_FIBRE |
-			SUPPORTED_BNC | SUPPORTED_Pause | SUPPORTED_Asym_Pause);
-
-    val = mars_ext_read(phydev, 0xa001);
-    /*bit2-bit0:
-    3'b000: UTP_TO_RGMII;
-    3'b001: FIBER_TO_RGMII;
-    3'b010: UTP_FIBER_TO_RGMII;
-    3'b011: UTP_TO_SGMII;
-    3'b100: SGPHY_TO_RGMAC;
-    3'b101: SGMAC_TO_RGPHY;
-    3'b110: UTP_TO_FIBER_AUTO; 
-    3'b111: UTP_TO_FIBER_FORCE. */
-    if((val & 0x7) == 0x0)
-    {
-        /* for UTP-RGMII mode, config SyncE_CFG, enable SyncE clock output, for ls1023a change 25M to 125M */
-        if (phydev->phy_id == YT8531S_PHY_ID)
-        {
-            mars_ext_write(phydev, 0xa012, 0xd0);
-		}
-        else
-        {
-            mars_ext_write(phydev, 0xa012, 0x68);
-        }
-    }
-
-	/* Do we support autonegotiation? */
-	val = phy_read(phydev, MII_BMSR);
-	if (val < 0)
-		return val;
-
-	if (val & BMSR_ANEGCAPABLE)
-		features |= SUPPORTED_Autoneg;
-
-	if (val & BMSR_100FULL)
-		features |= SUPPORTED_100baseT_Full;
-	if (val & BMSR_100HALF)
-		features |= SUPPORTED_100baseT_Half;
-	if (val & BMSR_10FULL)
-		features |= SUPPORTED_10baseT_Full;
-	if (val & BMSR_10HALF)
-		features |= SUPPORTED_10baseT_Half;
-
-	if (val & BMSR_ESTATEN) {
-		val = phy_read(phydev, MII_ESTATUS);
-		if (val < 0)
-			return val;
-
-		if (val & ESTATUS_1000_TFULL)
-			features |= SUPPORTED_1000baseT_Full;
-		if (val & ESTATUS_1000_THALF)
-			features |= SUPPORTED_1000baseT_Half;
-	}
-
-	phydev->supported &= features;
-	phydev->advertising &= features;
-
-	mars_get_port_type(phydev);
-
-	return 0;
-}
