+/* Hardware init flow */
+static void ctcmac_hw_init(struct ctcmac_private *priv)
+{
+	int i;
+	u32 val;
+	int use_extram = 0;
+
+	/* tx/rx polarity invert */
+	ctc_mac_pol_inv(priv);
+
+	/* two cpumac access the same cpumac unit register */
+	spin_lock_irq(&global_reglock);   
+	if(priv->index == 0){
+		/* release CpuMac0 */
+		clrsetbits(&priv->cpumacu_reg_v2p0->CpuMacUnitResetCtl, 
+		    BIT(CPU_MAC_UNIT_RESET_CTL_W0_RESET_CORE_BASE_BIT_V2P0), 
+		    BIT(CPU_MAC_UNIT_RESET_CTL_W0_RESET_CORE_CPU_MAC0_BIT_V2P0));
+		clrsetbits(&priv->cpumacu_reg_v2p0->CpuMacUnitResetCtl, 
+		    BIT(CPU_MAC_UNIT_RESET_CTL_W0_RESET_CORE_CPU_MAC0_BIT_V2P0), 0);
+	}else{
+		/* release CpuMac0 */
+		clrsetbits(&priv->cpumacu_reg_v2p0->CpuMacUnitResetCtl, 
+		    BIT(CPU_MAC_UNIT_RESET_CTL_W0_RESET_CORE_BASE_BIT_V2P0), 
+		    BIT(CPU_MAC_UNIT_RESET_CTL_W0_RESET_CORE_CPU_MAC1_BIT_V2P0));
+		clrsetbits(&priv->cpumacu_reg_v2p0->CpuMacUnitResetCtl, 
+		    BIT(CPU_MAC_UNIT_RESET_CTL_W0_RESET_CORE_CPU_MAC1_BIT_V2P0), 0);
+	}
+
+	clrsetbits(&priv->cpumacu_reg_v2p0->CpuMacUnitTsCfg, 
+	            0, BIT(CPU_MAC_UNIT_TS_CFG_W0_CFG_FORCE_S_AND_NS_EN_BIT_V2P0));
+
+	spin_unlock_irq(&global_reglock);
+	mdelay(10);
+
+	/* init CpuMac */
+	clrsetbits(&priv->cpumac_reg_v2p0->CpuMacInit, 0, BIT(CPU_MAC_INIT_DONE_W0_INIT_DONE_BIT_V2P0));
+	udelay(1);
+	
+	if (priv->interface == PHY_INTERFACE_MODE_SGMII){
+		/* switch to sgmii and enable auto nego */
+		val = readl(&priv->cpumac_reg_v2p0->CpuMacSgmiiAutoNegCfg);
+		val &= ~(CPU_MAC_SGMII_AUTO_NEG_CFG_W0_CFG_AN_ENABLE_MASK_V2P0
+		              | CPU_MAC_SGMII_AUTO_NEG_CFG_W0_CFG_AN_MODE_MASK_V2P0);
+		val |= (CSA_SGMII_MD_MASK | CSA_EN);
+		writel(val, &priv->cpumac_reg_v2p0->CpuMacSgmiiAutoNegCfg);
+	}
+
+	if(priv->autoneg_mode == CTCMAC_AUTONEG_DISABLE){
+		clrsetbits(&priv->cpumac_reg_v2p0->CpuMacSgmiiAutoNegCfg, 
+			BIT(CPU_MAC_SGMII_AUTO_NEG_CFG_W0_CFG_AN_ENABLE_BIT_V2P0), 0);
+		
+	}else{
+		val = readl(&priv->cpumac_reg_v2p0->CpuMacSgmiiAutoNegCfg);
+		val &= ~CPU_MAC_SGMII_AUTO_NEG_CFG_W0_CFG_AN_MODE_MASK_V2P0;
+		val |= (priv->autoneg_mode<<2 | BIT(CPU_MAC_SGMII_AUTO_NEG_CFG_W0_CFG_AN_ENABLE_BIT_V2P0));
+		writel(val, &priv->cpumac_reg_v2p0->CpuMacSgmiiAutoNegCfg);
+	}
+	clrsetbits(&priv->cpumac_reg_v2p0->CpuMacSgmiiAutoNegCfg, 
+			0, BIT(CPU_MAC_SGMII_AUTO_NEG_CFG_W0_CFG_IGNORE_ANEG_ERR_BIT_V2P0));
+	clrsetbits(&priv->cpumac_reg_v2p0->CpuMacSgmiiAutoNegCfg, 
+			0, BIT(CPU_MAC_SGMII_AUTO_NEG_CFG_W0_CFG_IGNORE_LINK_FAILURE_BIT_V2P0));
+
+	/* disable rx link filter */
+	clrsetbits(&priv->cpumac_reg_v2p0->CpuMacSgmiiCfg[0], 
+	    BIT(CPU_MAC_SGMII_CFG_W0_CFG_MII_RX_LINK_FILTER_EN_BIT_V2P0), 0);
+	/* ignore tx event */
+	clrsetbits(&priv->cpumac_reg_v2p0->CpuMacSgmiiCfg[0], 
+	    0, BIT(CPU_MAC_SGMII_CFG_W0_CFG_TX_EVEN_IGNORE_BIT_V2P0));
+
+	clrsetbits(&priv->cpumac_reg_v2p0->CpuMacAxiCfg, 
+	    0, BIT(CPU_MAC_AXI_CFG_W0_CFG_AXI_RD_D_WORD_SWAP_EN_BIT_V2P0));
+	clrsetbits(&priv->cpumac_reg_v2p0->CpuMacAxiCfg, 
+	    0, BIT(CPU_MAC_AXI_CFG_W0_CFG_AXI_WR_D_WORD_SWAP_EN_BIT_V2P0));
+
+	/* drop over size packet */
+	clrsetbits(&priv->cpumac_reg_v2p0->CpuMacGmacCfg[0], 
+	    0, BIT(CPU_MAC_GMAC_CFG_W0_CFG_RX_OVERRUN_DROP_EN_BIT_V2P0)
+	        |BIT(CPU_MAC_GMAC_CFG_W0_CFG_RX_OVERSIZE_DROP_EN_BIT_V2P0));
+
+	/* not strip 4B crc when send packet  */
+	clrsetbits(&priv->cpumac_reg_v2p0->CpuMacGmacCfg[2], 
+	    BIT(CPU_MAC_GMAC_CFG_W2_CFG_TX_STRIP_CRC_EN_BIT_V2P0), 0);
+
+	/* enable cut-through mode */
+	clrsetbits(&priv->cpumac_reg_v2p0->CpuMacGmacCfg[2], 
+	    0, BIT(CPU_MAC_GMAC_CFG_W2_CFG_TX_CUT_THROUGH_EN_BIT_V2P0));
+    
+	for (i = 0; i < priv->num_tx_queues; i++) {
+		if(priv->tx_queue[i]->tx_ring_size > CTCMAC_INTERNAL_RING_SIZE){
+			use_extram = 1;
+			break;
+		}
+	}
+
+	for (i = 0; i < priv->num_rx_queues; i++) {
+		if(priv->rx_queue[i]->rx_ring_size > CTCMAC_INTERNAL_RING_SIZE){
+			use_extram = 1;
+			break;
+		}
+	}
+        
+	if(use_extram){
+		spin_lock_irq(&global_reglock); 
+		/* enable external SRAM to store rx/tx desc, support max 1023*3 desc */
+		regmap_read(regmap_base, offsetof(struct SysCtl_regs, SysMemCtl), &val);
+		val |= SYS_MEM_CTL_W0_CFG_RAM_MUX_EN;
+		regmap_write(regmap_base, offsetof(struct SysCtl_regs, SysMemCtl), val);
+		spin_unlock_irq(&global_reglock); 
+		
+		if(priv->index == 0){
+			ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacExtRamCfg[1], CTCMAC0_EXSRAM_BASE);
+		}else{
+			ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacExtRamCfg[1], CTCMAC1_EXSRAM_BASE);
+		}
+		ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacExtRamCfg[0], CTCMAC_TX_RING_SIZE);
+		clrsetbits(&priv->cpumac_reg_v2p0->CpuMacExtRamCfg[0], 
+			0, BIT(CPU_MAC_EXT_RAM_CFG_W0_CFG_EXT_RAM_EN_BIT_V2P0));
+	}else{
+		/* disable external SRAM to store rx/tx desc, support max 64*3 desc */
+		clrsetbits(&priv->cpumac_reg_v2p0->CpuMacExtRamCfg[0], 
+		    BIT(CPU_MAC_EXT_RAM_CFG_W0_CFG_EXT_RAM_EN_BIT_V2P0), 0);
+		spin_lock_irq(&global_reglock); 
+		
+		regmap_read(regmap_base, offsetof(struct SysCtl_regs, SysMemCtl), &val);
+		val &= ~SYS_MEM_CTL_W0_CFG_RAM_MUX_EN;
+		regmap_write(regmap_base, offsetof(struct SysCtl_regs, SysMemCtl), val);
+		spin_unlock_irq(&global_reglock); 
+	}
+
+	if(priv->int_type == CTCMAC_INT_DESC){
+			val = BIT(CPU_MAC_DESC_CFG_W0_CFG_TX_DESC_ACK_EN_BIT_V2P0)			
+			|(priv->rx_int_coalesce_cnt<<16)
+			|(priv->rx_int_coalesce_cnt<<8)
+			|(priv->tx_int_coalesce_cnt<<0);
+		ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacDescCfg[0], val);
+		if(priv->version > 0){
+			val = ctcmac_regr(&priv->cpumac_reg_v2p0->CpuMacDescCfg1[0]);
+			val |= (1<<CPU_MAC_DESC_CFG1_W0_CFG_RX_DESC_DONE_INTR_TIMER_EN)
+				| (1<<CPU_MAC_DESC_CFG1_W0_CFG_TX_DESC_DONE_INTR_TIMER_EN);
+			ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacDescCfg1[0], val);
+			ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacDescCfg1[1], CTCMAC_TIMER_THRD);
+			ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacDescCfg1[2], CTCMAC_TIMER_THRD);
+		}
+	}else{
+		val = BIT(CPU_MAC_DESC_CFG_W0_CFG_TX_DESC_DONE_INTR_EOP_EN_BIT_V2P0)
+			|BIT(CPU_MAC_DESC_CFG_W0_CFG_RX_DESC_DONE_INTR_EOP_EN_BIT_V2P0)
+			|BIT(CPU_MAC_DESC_CFG_W0_CFG_TX_DESC_ACK_EN_BIT_V2P0);
+		ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacDescCfg[0], val);
+	}
+	
+	ctcmac_mac_filter_init(priv);
+	
+	/* clear and mask all interrupt */
+	ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacInterruptFunc[1], 0xffffffff);
+	ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacInterruptNormal[1], 0xffffffff);
+	ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacInterruptFunc[2], 0xffffffff);
+	ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacInterruptNormal[2], 0xffffffff);
+
+	if(priv->version > 0){
+		ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacInterruptFunc0[1], 0xffffffff);
+		ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacInterruptFunc1[1], 0xffffffff);
+		ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacInterruptFunc0[2], 0xffffffff);
+		ctcmac_regw(&priv->cpumac_reg_v2p0->CpuMacInterruptFunc1[2], 0xffffffff);
+	}
+
+#if 0
+	if (!(priv->ndev->flags & IFF_PROMISC)){
+		ctcmac_init_mac_filter(priv);
+	}
+#endif
+    
+}
