+	u8 tx_pol_inv;
+	u8 rx_pol_inv;
+	struct timer_list token_timer;
+	u8 version;
+	u8 pause_aneg_en;
+	u8 tx_pause_en;
+	u8 rx_pause_en;
+};
+
+struct ctcmac_pkt_stats{
+	u64 rx_good_ucast_bytes;
