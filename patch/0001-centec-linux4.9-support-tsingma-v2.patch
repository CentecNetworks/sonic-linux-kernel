+int ctc_mac_serdes0_init_v2p0(struct CpuMacUnit_regs_v2p0 *cpumacu_reg_v2p0)
+{
+	u32 val0;
+
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1HssReset);	
+	val0 &= ~CPU_MAC_UNIT_12G1_HSS_RESET_W0_RESET_HSS_GRP_ACC_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1HssReset);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1HssReset);	
+	val0 |= CPU_MAC_UNIT_12G1_HSS_RESET_W0_CFG_HSS_L0_RST_LANE_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1HssReset);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1HssReset);	
+	val0 &= ~CPU_MAC_UNIT_12G1_HSS_RESET_W0_CFG_HSS_L0_RST_LANE_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1HssReset);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1HssReset);	
+	val0 |= CPU_MAC_UNIT_12G1_HSS_RESET_W0_CFG_HSS_L0_RST_FSM_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1HssReset);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1TxCfg[0]);
+	val0 |= CPU_MAC_UNIT_12G1_TX_CFG_W0_HSS_TX_CFG_0_CFG_TX_DATA_OFF_MASK_V2P0;
+	writel(val0,  &cpumacu_reg_v2p0->CpuMacUnit12G1TxCfg[0]);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1MiscCfg[0]);
+	val0 |= CPU_MAC_UNIT_12G1_MISC_CFG_W0_HSS_MISC_CFG_0_CFG_POVREF_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1MiscCfg[0]);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 0, 0x1, &val0);
+	val0 |= 0x8000;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 0, 0x1, val0);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1MiscCfg[0]);
+	val0 &= ~CPU_MAC_UNIT_12G1_MISC_CFG_W0_HSS_MISC_CFG_0_CFG_P0_PLL_MASK_V2P0;
+	val0 &= ~CPU_MAC_UNIT_12G1_MISC_CFG_W0_HSS_MISC_CFG_0_CFG_P0_RX_MASK_V2P0;
+	val0 &= ~CPU_MAC_UNIT_12G1_MISC_CFG_W0_HSS_MISC_CFG_0_CFG_P0_TX_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1MiscCfg[0]);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 0, 0x26, &val0);
+	val0 |= 0x800;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 0, 0x26, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 0, 0x1, &val0);
+	val0 &= ~0xe0;
+	val0 |= (4<<5);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 0, 0x1, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 0, 0x4f, &val0);
+	val0 &= ~0x400;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 0, 0x4f, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 0, 0x1, &val0);
+	val0 &= ~0x1f;
+	val0 |= 0xc;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 0, 0x1, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 0, 0x4b, &val0);
+	val0 |= 0x800;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 0, 0x4b, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 0, 0x4b, &val0);
+	val0 &= ~0x800;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 0, 0x4b, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 0, 0x23, &val0);
+	val0 &= ~0xe;
+	val0 |= (1<<1);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 0, 0x23, val0);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1TxCfg[0]);
+	val0 &= ~CPU_MAC_UNIT_12G1_TX_CFG_W0_HSS_TX_CFG_0_CFG_GEN_MODE_MASK_V2P0;
+	val0 |= (6<<0);
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1TxCfg[0]);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1RxCfg[0]);
+	val0 &= ~CPU_MAC_UNIT_12G1_RX_CFG_W0_HSS_RX_CFG_0_CFG_GEN_MODE_MASK_V2P0;
+	val0 |= (6<<0);
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1RxCfg[0]);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 0, 0xf6, &val0);
+	val0 &= ~0xf0;
+	val0 |= (1<<4);
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 0, 0xf6, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 0, 0x1, &val0);
+	val0 |= 0x8000;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 0, 0x1, val0);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1MiscCfg[0]);
+	val0 |= CPU_MAC_UNIT_12G1_MISC_CFG_W0_HSS_MISC_CFG_0_CFG_P0_PLL_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1MiscCfg[0]);
+
+	mdelay(1);
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1MiscCfg[0]);
+	val0 |= CPU_MAC_UNIT_12G1_MISC_CFG_W0_HSS_MISC_CFG_0_CFG_P0_TX_MASK_V2P0;	
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1MiscCfg[0]);
+
+	mdelay(1);
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1MiscCfg[0]);
+   	val0 |= CPU_MAC_UNIT_12G1_MISC_CFG_W0_HSS_MISC_CFG_0_CFG_P0_RX_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1MiscCfg[0]);
+	mdelay(1);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 0, 0x52, &val0);
+	val0 |= 0x400;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 0, 0x52, val0);
+
+	ctc_mac_hss_read(cpumacu_reg_v2p0, 0, 0x52, &val0);
+	val0 &= ~0x400;
+	ctc_mac_hss_write(cpumacu_reg_v2p0, 0, 0x52, val0);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1TxCfg[0]);
+	val0 &= ~CPU_MAC_UNIT_12G1_TX_CFG_W0_HSS_TX_CFG_0_CFG_TX_DATA_OFF_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1TxCfg[0]);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1RxCfg[0]);
+	val0 &= ~CPU_MAC_UNIT_12G1_RX_CFG_W0_HSS_RX_CFG_0_CFG_CTLE_AUTO_EN_MASK_V2P0;
+	val0 &= ~CPU_MAC_UNIT_12G1_RX_CFG_W0_HSS_RX_CFG_0_CFG_DFE_OVRD_N_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1RxCfg[0]);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1TxCfg[0]);
+	val0 &= ~CPU_MAC_UNIT_12G1_TX_CFG_W0_HSS_TX_CFG_0_CFG_LT_ENABLE_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1TxCfg[0]);
+
+	val0 = readl(&cpumacu_reg_v2p0->CpuMacUnit12G1TxCfg[0]);
+	val0 &= ~CPU_MAC_UNIT_12G1_TX_CFG_W1_HSS_TX_CFG_1_CFG_TX_DATA_OFF_MASK_V2P0;
+	writel(val0, &cpumacu_reg_v2p0->CpuMacUnit12G1TxCfg[0]);
+	mdelay(20);
+
