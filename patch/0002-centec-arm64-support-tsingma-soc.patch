diff --git a/arch/arm64/boot/dts/centec/ctc5236-emu.dts b/arch/arm64/boot/dts/centec/ctc5236-emu.dts
new file mode 100644
index 0000000..5341673
--- /dev/null
+++ b/arch/arm64/boot/dts/centec/ctc5236-emu.dts
@@ -0,0 +1,218 @@
+/*
+ * dts file for Centec CTC5236(TsingMa) SoC Emulation Board
+ *
+ * (C) Copyright 2004-2017 Centec Networks (suzhou) Co., LTD.
+ *
+ * Jay Cao <caoj@centecnetworks.com>
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of
+ * the License, or (at your option) any later version.
+ */
+
+/dts-v1/;
+#include "ctc5236_emu.dtsi"
+
+/ {
+	model = " CTC5236(TsingMa) Emulation Board";
+	compatible = "ctc5236,ctc5236-emu";
+
+	memory {
+		device_type = "memory";
+		reg = <0 0x80000000 0 0x80000000>;
+	};
+
+	chosen {
+		stdout-path = "serial0:9600n8";
+	};
+
+	aliases {
+		serial0 = &serial0;
+		serial1 = &serial1;
+		serial2 = &serial2;
+		ethernet0 = &enet0;
+		ethernet1 = &enet1;
+	};
+					
+};
+
+&serial0 {
+	status = "okay";
+};
+
+&serial1 {
+	status = "okay";
+};
+
+&serial2 {
+        status = "disabled";
+		pinctrl-names = "default";
+        pinctrl-0 = <&uart2_pin>;
+};
+
+&enet0 {
+	status = "okay";
+	phy-connection-type = "mii";
+	auto-nego-mode = "disable";
+	fixed-link {
+		speed = <10>;
+		full-duplex;
+	};
+};
+
+&enet1 {
+	status = "okay";
+	phy-connection-type = "mii";
+	auto-nego-mode = "disable";
+	fixed-link {
+		speed = <10>;
+		full-duplex;
+	};
+};
+
+&qspi {
+	status = "okay";	
+		
+	qspiflash: mx25u3235f@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0x0>;
+		spi-cpha; 
+		spi-cpol;
+		spi-max-frequency = <25000000>;
+		
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x0 0x300000>;
+				};
+			partition@300000 {
+				label = "uboot parameters";
+				reg = <0x300000 0x10000>;
+				};
+			partition@310000 {
+				label = "system";
+				reg = <0x310000 0x1cf0000>;
+				};	
+		};
+	};
+};
+
+&spi {
+	status = "disabled";	
+	
+	spi-loopback {
+		compatible = "linux,spi-loopback-test";
+		reg = <0x1>;
+		spi-max-frequency = <1000000>;
+	};
+		
+	spiflash: w25q128@0 {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "jedec,spi-nor";
+		reg = <0>;		
+		pl022,com-mode = <0x0>; 		
+		spi-max-frequency = <1000000>;
+	};
+};
+
+&switch {
+	status = "disabled";
+};
+
+
+&switch1 {
+	status = "disabled";
+};
+
+&i2c0{
+	status = "okay";
+	clock-frequency = <400000>;
+	
+	eeprom1:eeprom@56 { 
+		compatible = "atmel,24c64";
+		reg = <0x56>;
+		pagesize = <32>; 
+		};
+		
+	lm77:sensor@48{
+		compatible = "lm77";
+		reg = <0x48>;
+		};	
+	
+	rtc:rtc@32{
+		compatible = "sd2405";
+		reg = <0x32>;
+		};
+};  
+
+&i2c1{
+	status = "disabled";
+	clock-frequency = <400000>;
+	
+	eeprom2:eeprom@56 { 
+		compatible = "atmel,24c64";
+		reg = <0x56>;
+		pagesize = <32>; 
+		};
+};
+
+&ehci0 {
+        status = "disabled";
+};
+
+&wtd0{
+	status = "disabled";
+};
+
+&wtd1{
+	status = "disabled";
+};
+
+&sdhci {
+	bus-width = <4>;
+	max-frequency = <100000000>;
+	no-sd;
+	no-sdio;
+	voltage-ranges = <3300 3300>;
+	status = "okay";
+	non-removable;
+};
+
+&timer0 {
+	status = "disabled";
+};
+
+&pwm {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm0_pin>;
+	status = "disabled";
+};
+
+&spi_pin{
+	ctc,pins = <0 0 PIN_FUNC_SPI>,
+		         <0 2 PIN_FUNC_SPI>,
+	                 <0 3 PIN_FUNC_SPI>,
+			 <0 5 PIN_FUNC_SPI>;
+};
+
+&pinctrl {
+	pwm0 {
+			pwm0_pin: pwm0_pin {
+				ctc,pins = <0 4  PIN_FUNC_PWM>,
+  				                 <0 9  PIN_FUNC_PWM>,
+  				                 <0 10 PIN_FUNC_PWM>,
+  				                 <0 11 PIN_FUNC_PWM>,
+						 <0 12 PIN_FUNC_PWM>,
+						 <0 13 PIN_FUNC_PWM>,
+						 <0 14 PIN_FUNC_PWM>,
+						 <0 15 PIN_FUNC_PWM>;
+			};
+		};
+};
+
