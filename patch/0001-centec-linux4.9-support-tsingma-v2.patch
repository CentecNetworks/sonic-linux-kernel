 			 | SDHCI_QUIRK2_BROKEN_HS200,
-	.quirks = SDHCI_QUIRK_CAP_CLOCK_BASE_BROKEN,
+	.quirks = SDHCI_QUIRK_CAP_CLOCK_BASE_BROKEN
+			 | SDHCI_QUIRK_BROKEN_TIMEOUT_VAL,
 };
 
+static void ctc_mmc_phy_set_pad(struct sdhci_host *host,
+					   struct mmc_ios *ios)
+{
+	u16 clk;
+	u32 phy_cfg;
+	u8 weakpull_en;
+	u8 rxsel;
+	u8 pad_sn;
+	u8 pad_sp;
+	u16 cmdpad;
+	u16 datpad;
+	u16 clkpad;
+	u16 rstpad;
+	u8 txslew_ctrl_n;
+	u8 txslew_ctrl_p;
+
+	clk = sdhci_readw(host, SDHCI_CLOCK_CONTROL);
+	clk &= ~SDHCI_CLOCK_CARD_EN;
+	sdhci_writew(host, clk, SDHCI_CLOCK_CONTROL);
+
+	switch (ios->timing) {
+	case MMC_TIMING_LEGACY:
+	case MMC_TIMING_MMC_HS:
+	case MMC_TIMING_MMC_DDR52:
+		/* Drive strength */
+		phy_cfg = sdhci_readl(host, PHY_CNFG);
+		pad_sn = 0x8;
+		pad_sp = 0x8;
+
+		phy_cfg |= pad_sp << 16 | pad_sn << 20;
+		sdhci_writel(host, phy_cfg, PHY_CNFG);
+		/* CMD PAD */
+		cmdpad = sdhci_readw(host, CMDPAD_CNFG);
+		txslew_ctrl_n = 0x2;
+		txslew_ctrl_p = 0x3;
+		rxsel = 0x2;
+		cmdpad |= txslew_ctrl_n << 9 | txslew_ctrl_p << 5 | rxsel;
+		sdhci_writew(host, cmdpad, CMDPAD_CNFG);
+		/* DATA PAD */
+		datpad = sdhci_readw(host, DATPAD_CNFG);
+		txslew_ctrl_n = 0x2;
+		txslew_ctrl_p = 0x3;
+		weakpull_en = 0x1;
+		rxsel = 0x2;
+		datpad |=
+		    txslew_ctrl_n << 9 | txslew_ctrl_p << 5 | weakpull_en << 3 |
+		    rxsel;
+		sdhci_writew(host, datpad, DATPAD_CNFG);
+		/* CLK PAD */
+		clkpad = sdhci_readw(host, CLKPAD_CNFG);
+		txslew_ctrl_n = 0x2;
+		txslew_ctrl_p = 0x3;
+		clkpad |= txslew_ctrl_n << 9 | txslew_ctrl_p << 5;
+		sdhci_writew(host, clkpad, CLKPAD_CNFG);
+		/* Without STB PAD */
+		/* RST PAD */
+		rstpad = sdhci_readw(host, RSTNPAD_CNFG);
+		txslew_ctrl_n = 0x2;
+		txslew_ctrl_p = 0x3;
+		rxsel = 0x2;
+		rstpad |= txslew_ctrl_n << 9 | txslew_ctrl_p << 5 | rxsel;
+		sdhci_writew(host, rstpad, RSTNPAD_CNFG);
+
+		break;
+	default:
+		dev_err(mmc_dev(host->mmc), "phy set pad err\n");
+		break;
+	}
+
+	clk = sdhci_readw(host, SDHCI_CLOCK_CONTROL);
+	clk |= SDHCI_CLOCK_CARD_EN;
+	sdhci_writew(host, clk, SDHCI_CLOCK_CONTROL);
+}
+
+static void ctc_mmc_phy_set_delayline(struct sdhci_host *host,
+						 struct mmc_ios *ios)
+{
+	u16 clk;
+
+	clk = sdhci_readw(host, SDHCI_CLOCK_CONTROL);
+	clk &= ~SDHCI_CLOCK_CARD_EN;
+	sdhci_writew(host, clk, SDHCI_CLOCK_CONTROL);
+
+	sdhci_writeb(host, 0x8, SMPLDL_CNFG);
+	sdhci_writeb(host, 0x8, ATDL_CNFG);
+
+	switch (ios->timing) {
+	case MMC_TIMING_LEGACY:
+	case MMC_TIMING_MMC_HS:
+		sdhci_writeb(host, 0x7f, SDCLKDL_DC);
+		break;
+	case MMC_TIMING_MMC_DDR52:
+		sdhci_writeb(host, 0x48, SDCLKDL_DC);
+		break;
+	default:
