+static void ctcmac_mac_filter_init(struct ctcmac_private *priv)
+{
+	unsigned char *dev_addr;
+	u32 val, addr_h=0, addr_l=0;
+
+	if(priv->version == 0)
+		return ;
+	
+	/*  mac filter table 0~3 are assigned to cpumac0
+	     mac filter table 4~7 are assigned to cpumac1  
+	     mac filter table 0/4:white list to receive pacekt with local mac address 
+	     mac filter table 1/5:white list to receive pacekt with broadcast mac address
+	     mac filter table 2/6:white list to receive pacekt with multicast mac address
+	     mac filter table 3/7:white list to receive pacekt with multicast mac address
+	*/
+
+	/* 1. mac filter table 0~3 are assigned to cpumac0
+	        mac filter table 4~7 are assigned to cpumac1  */
+	if(priv->index == 0){
+		val = readl(&priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[0]);
+		val |= (0xf<<16);
+		val &= ~(0xf0<<16);
+		writel(val, &priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[0]);
+		
+		val = readl(&priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[1]);
+		val |= BIT(CPU_MAC_UNIT_FILTER_CFG1_W1_CFG_CHECK_NORMAL_PKT_ENABLE0_BIT_V2P0);
+		val |= BIT(CPU_MAC_UNIT_FILTER_CFG1_W1_CFG_DROP_NORMAL_PKT0_BIT_V2P0);
+		writel(val, &priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[1]);
+	}else{
+		val = readl(&priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[0]);
+		val |= (0xf0<<24);
+		val &= ~(0xf<<24);
+		writel(val, &priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[0]);
+
+		val = readl(&priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[1]);
+		val |= BIT(CPU_MAC_UNIT_FILTER_CFG1_W1_CFG_CHECK_NORMAL_PKT_ENABLE1_BIT_V2P0);
+		val |= BIT(CPU_MAC_UNIT_FILTER_CFG1_W1_CFG_DROP_NORMAL_PKT1_BIT_V2P0);
+		writel(val, &priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg1[1]);
+	}
+
+	/* 2. enable mac filter function */
+	val = readl(&priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg[0]);
+	val |= BIT(CPU_MAC_UNIT_FILTER_CFG_W0_CFG_MAC_FILTER_EN_BIT_V2P0);
+	val &= ~BIT(CPU_MAC_UNIT_FILTER_CFG_W0_CFG_MAC_CAM_IS_BLACK_LIST_BIT_V2P0);
+	val &= ~BIT(CPU_MAC_UNIT_FILTER_CFG_W0_CFG_MAC_ADDR_IS_SA0_BIT_V2P0);
+	val &= ~BIT(CPU_MAC_UNIT_FILTER_CFG_W0_CFG_MAC_ADDR_IS_SA1_BIT_V2P0);
+	val &= ~BIT(CPU_MAC_UNIT_FILTER_CFG_W0_CFG_MAC_ADDR_IS_SA2_BIT_V2P0);
+	val &= ~BIT(CPU_MAC_UNIT_FILTER_CFG_W0_CFG_MAC_ADDR_IS_SA3_BIT_V2P0);
+	val &= ~BIT(CPU_MAC_UNIT_FILTER_CFG_W0_CFG_MAC_ADDR_IS_SA4_BIT_V2P0);
+	val &= ~BIT(CPU_MAC_UNIT_FILTER_CFG_W0_CFG_MAC_ADDR_IS_SA5_BIT_V2P0);
+	val &= ~BIT(CPU_MAC_UNIT_FILTER_CFG_W0_CFG_MAC_ADDR_IS_SA6_BIT_V2P0);
+	val &= ~BIT(CPU_MAC_UNIT_FILTER_CFG_W0_CFG_MAC_ADDR_IS_SA7_BIT_V2P0);
+	writel(val, &priv->cpumacu_reg_v2p0->CpuMacUnitFilterCfg[0]);
+
+	/* 3. mac filter table 0/4:white list to receive pacekt with local mac address  */
+	dev_addr = priv->ndev->dev_addr;
+	addr_h = dev_addr[0]<<8 | dev_addr[1]; 
+	addr_l = dev_addr[2]<<24 | dev_addr[3]<<16 | dev_addr[4]<<8 | dev_addr[5];
+	if(priv->index == 0){
+		writel(addr_l, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[0]);
+		writel(addr_h, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[1]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[16]);
+		writel(0x0000ffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[17]);
+	}else{
+		writel(addr_l, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[8]);
+		writel(addr_h, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[9]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[24]);
+		writel(0x0000ffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[25]);
+	}
+	
+	/* 4. mac filter table 1/5:white list to receive pacekt with broadcast mac address */
+	if(priv->index == 0){
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[2]);
+		writel(0x0000ffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[3]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[18]);
+		writel(0x0000ffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[19]);
+	}else{
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[10]);
+		writel(0x0000ffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[11]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[26]);
+		writel(0x0000ffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[27]);
+	}
+
+	/* mac filter table 2/6/3/7 reserved */
+	if(priv->index == 0){
+		writel(0x00000000, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[4]);
+		writel(0x00000000, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[5]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[20]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[21]);
+		
+		writel(0x00000000, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[6]);
+		writel(0x00000000, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[7]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[22]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[23]);
+	}else{
+		writel(0x00000000, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[12]);
+		writel(0x00000000, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[13]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[28]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[29]);
+
+		writel(0x00000000, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[14]);
+		writel(0x00000000, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[15]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[30]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[31]);
+	}
+
+}
