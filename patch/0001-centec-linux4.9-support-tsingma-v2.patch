+unsigned int ctc_sdhci_pltfm_clk_get_max_clock(struct sdhci_host *host)
+{
+	struct sdhci_pltfm_host *pltfm_host = sdhci_priv(host);
+
+	if (version == CTC_REV_TM_2_0)
+		return SDHCI_REFCLK_200M;
+	else
+		return clk_get_rate(pltfm_host->clk);
+}
