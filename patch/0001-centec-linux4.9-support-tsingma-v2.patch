+static void ctcmac_set_mac_for_addr(struct ctcmac_private *priv,
+				  const u8 *addr)
+{
+	u32 addr_h=0, addr_l=0;
+
+	addr_h = addr[0]<<8 | addr[1]; 
+	addr_l = addr[2]<<24 | addr[3]<<16 | addr[4]<<8 | addr[5];
+	if(priv->index == 0){
+		writel(addr_l, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[0]);
+		writel(addr_h, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[1]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[16]);
+		writel(0x0000ffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[17]);
+	}else{
+		writel(addr_l, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[8]);
+		writel(addr_h, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[9]);
+		writel(0xffffffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[24]);
+		writel(0x0000ffff, &priv->cpumacu_reg_v2p0->CpuMacUnitMacCamCfg[25]);
+	}
+}
+
+static void ctcmac_set_src_mac_for_flow_ctrl(struct ctcmac_private *priv,
+				  const u8 *addr)
+{
+	u32 val;
+	u32 addr_h=0, addr_l=0;
+
+	addr_h = addr[0]<<8 | addr[1]; 
+	addr_l = addr[2]<<24 | addr[3]<<16 | addr[4]<<8 | addr[5];
+	
+	writel(addr_l, &priv->cpumac_reg_v2p0->CpuMacPauseCfg[2]);
+	val = readl(&priv->cpumac_reg_v2p0->CpuMacPauseCfg[3]);
+	val &= 0xffff0000;
+	addr_h &= 0xffff;
+	val |= addr_h;
+	writel(val, &priv->cpumac_reg_v2p0->CpuMacPauseCfg[3]);
+}
