+static int mars_ack_interrupt(struct phy_device *phydev)
+{
+	int err;
+
+#if 1
+	/* Clear the interrupts by reading the reg */
+	err = phy_read(phydev, CTC_PHY_IEVENT);
+#else
+	err = mars_ext_read(phydev, 0xa011);
+#endif
+	if (err < 0)
+		return err;
+
+	return 0;
+}
