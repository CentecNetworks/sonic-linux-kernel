+/* update cpumac speed when phy linkup speed changed */
+static noinline void ctcmac_update_link_state(struct ctcmac_private *priv, struct phy_device *phydev)
+{
+	u32 cfg_rep, cfg_smp;
+	int speed = phydev->speed;
+
+
+	if (priv->interface != PHY_INTERFACE_MODE_SGMII)
+		return ;
+
+	if(netif_msg_link(priv)){
+		netdev_dbg(priv->ndev,"link up speed is %d\n", speed);
+	}
+
+	if (phydev->link) {
+		cfg_rep = readl(&priv->cpumac_reg_v2p0->CpuMacSgmiiCfg[0]);
+		cfg_smp = readl(&priv->cpumac_reg_v2p0->CpuMacSgmiiCfg[1]);
+		cfg_rep &= ~CSC_REP_MASK;
+		cfg_smp &= ~CSC_SMP_MASK;
+		if(speed == 1000){        
+			cfg_rep |= CSC_1000M;
+			cfg_smp |= CSC_1000M;
+		}
+		else if(speed == 100){
+			cfg_rep |= CSC_100M;
+			cfg_smp |= CSC_100M;
+		}
+		else if(speed == 10){
+			cfg_rep |= CSC_10M;
+			cfg_smp |= CSC_10M;
+		}
+		else{
+			return;
+		}
+		writel(cfg_rep, &priv->cpumac_reg_v2p0->CpuMacSgmiiCfg[0]);
+		writel(cfg_smp, &priv->cpumac_reg_v2p0->CpuMacSgmiiCfg[1]);
+		
+		ctcmac_adjust_flow_ctrl(priv);
+		ctcmac_serdes_init_post(priv);
+		ctcmac_wait_for_linkup(priv);
+		
+		if (!priv->oldlink)
+			priv->oldlink = 1;
+		
+	}else{
+		priv->oldlink = 0;
+		priv->oldspeed = 0;
+		priv->oldduplex = -1;
+	}
+	
+	return;
+}
+
+static void adjust_link(struct net_device *dev)
+{
+	struct ctcmac_private *priv = netdev_priv(dev);
+	struct phy_device *phydev = dev->phydev;
+
+	if (unlikely(phydev->link != priv->oldlink ||
+		     (phydev->link && (phydev->duplex != priv->oldduplex ||
+				       phydev->speed != priv->oldspeed))))
+	ctcmac_update_link_state(priv, phydev);
+}
