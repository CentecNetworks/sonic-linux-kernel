+	u32 token, token_max;
+	u32 rx_trigger;
+	struct	napi_struct napi_rx;
+};
+
+struct ctcmac_irqinfo {
+    unsigned int irq;
+    char name[32];
+};
+
+struct ctcmac_desc_cfg
+{
+    u8 err_type; /*used when err == 1*/
