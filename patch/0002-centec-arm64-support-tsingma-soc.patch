+
+/ {
+	model = "CTC5236(TsingMa) E520-48T6X Board";
+	compatible = "ctc5236,e520-48t6x";
+
+	memory {
+		device_type = "memory";
+		reg = <0 0x80000000 0x0 0x80000000>;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	aliases {
+		serial0 = &serial0;
+		ethernet0 = &enet0;
+		spi0 = &spi;
+		spi1 = &qspi;
+	};
+};
+
+&serial0 {
+	status = "okay";
+};
+
+&mdio {
+	status = "okay";
+    phy0: ethernet-phy@0 {
+		index = <0x00>;
+		reg = <0x01>;
+    };
+};
+
+&enet0 {
+	status = "okay";
+	phy-handle = <&phy0>;
+	auto-nego-mode= "sgmii-mac";
+};
+
+&qspi {
+	status = "okay";	
+		
+	qspiflash: W25Q32JVSSIQ@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0x0>;
+		spi-cpha; 
+		spi-cpol;
+		spi-max-frequency = <25000000>;
+		
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x0 0x300000>;
+			};
+			partition@300000 {
+				label = "uboot parameters";
+				reg = <0x300000 0x10000>;
+			};
+			partition@310000 {
+				label = "system";
+				reg = <0x310000 0xf0000>;
+			};		
+		};
+	};
+};
+
+&switch {
+	status = "okay";
+};
+
+
+&switch1 {
+	status = "okay";
+};
+
+
+&i2c0 {
+	status = "okay";
+	clock-frequency = <400000>;
+	
+	rtc_0:rtc_0@32 {
+		compatible = "sd2405";
+		reg = <0x32>;
+	};
+};  
+
+&ehci0 {
+	status = "okay";
+};
+
+&wtd0 {
+	status = "okay";
+};
+
+&sdhci {
+	bus-width = <8>;
+	max-frequency = <100000000>;
+	non-removable;
+	no-sd;
+	no-sdio;
+	voltage-ranges = <1800 1800>;
+	status = "okay";
+};
+
+&timer0 {
+	status = "okay";
+};
+
+&pwm {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm0_pin>;
+	status = "okay";
+};
+
+&pinctrl {
+	pwm0 {
+			pwm0_pin: pwm0_pin {
+				ctc,pins = <0 8  PIN_FUNC_PWM>,
+						<0 9  PIN_FUNC_PWM>,
+						<0 10 PIN_FUNC_PWM>,
+						<0 11 PIN_FUNC_PWM>,
+						<0 12 PIN_FUNC_PWM>,
+						<0 13 PIN_FUNC_PWM>,
+						<0 14 PIN_FUNC_PWM>,
+						<0 15 PIN_FUNC_PWM>;
+			};
+		};
+};
+
+&pcie{
+	status = "disabled";
+};
