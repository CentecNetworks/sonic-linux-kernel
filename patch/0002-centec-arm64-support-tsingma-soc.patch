+#define CSC_REP_MASK   0x1fc00000
+#define CSC_SMP_MASK   0x1fc00000
+/*CTCMAC_SGMII_MON*/
+#define CSM_ANST_MASK 0x00000007
+  
+
+#define CSC_1000M 0x00000000
+#define CSC_100M  0x02400000
+#define CSC_10M    0x18c00000
